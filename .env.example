DATABASE_URL=postgresql://dfsha:dfsha@postgres:5432/dfsha
JWT_SECRET=changeme
JWT_EXPIRATION=3600
INTERNAL_API_KEY=changeme-internal
# Clave Fernet para cifrar los bloques en reposo. Generar una propia con:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=changeme-genere-una-clave-fernet-valida
BLOCK_SIZE_MB=64
REPLICATION_FACTOR=2
MAX_RETRIES=3
MAX_PARALLEL_DOWNLOADS=8
LOCK_TIMEOUT_SECONDS=30
HEALTH_CHECK_INTERVAL_SECONDS=10
DATANODE_FAILURE_THRESHOLD=3
TEMP_SPACE_MARGIN_PERCENT=10
STORAGE_ROOT=/data/dfsha
# DataNodes esperados por el ControlNode, en formato node_id:host:puerto
# separados por coma. El host corresponde al nombre del servicio en la red Docker.
DATANODES=DN1:data_node_1:8000,DN2:data_node_2:8000,DN3:data_node_3:8000