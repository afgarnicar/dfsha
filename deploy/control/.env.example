# Configuración de la VM del ControlNode (VM1).
# Copie este archivo como .env en la misma carpeta y cambie los valores marcados.
# El .env NO se sube a git.

# --- Base de datos (solo visible dentro de la red de Docker de esta VM) ---
POSTGRES_USER=dfsha
POSTGRES_DB=dfsha
# CAMBIAR: contraseña de PostgreSQL. Debe ser la misma que va en DATABASE_URL.
POSTGRES_PASSWORD=cambie-esta-clave
DATABASE_URL=postgresql://dfsha:cambie-esta-clave@postgres:5432/dfsha

# --- Seguridad ---
# CAMBIAR: generar con  openssl rand -hex 32
JWT_SECRET=cambie-este-secreto
JWT_EXPIRATION=3600
# CAMBIAR: generar con  openssl rand -hex 32. La misma en todas las VMs: de ella
# se deriva también el certificado del HTTPS entre ControlNode y DataNodes.
INTERNAL_API_KEY=cambie-esta-clave-interna
# CAMBIAR: clave Fernet para cifrar los bloques. Se genera con el comando de la guía.
ENCRYPTION_KEY=genere-una-clave-fernet

# --- DataNodes: node_id:IP_PRIVADA:puerto, separados por coma ---
# CAMBIAR: poner las IP privadas de las VM2, VM3 y VM4 (consola de EC2,
# columna "Private IPv4 address").
DATANODES=DN1:172.31.0.11:8000,DN2:172.31.0.12:8000,DN3:172.31.0.13:8000

# --- Parámetros del sistema (no cambiar sin hablarlo en equipo) ---
BLOCK_SIZE_MB=64
REPLICATION_FACTOR=2
MAX_RETRIES=3
MAX_PARALLEL_DOWNLOADS=8
LOCK_TIMEOUT_SECONDS=30
HEALTH_CHECK_INTERVAL_SECONDS=10
DATANODE_FAILURE_THRESHOLD=3
TEMP_SPACE_MARGIN_PERCENT=10
TEMP_ROOT=/tmp/dfsha
CLEANUP_INTERVAL_SECONDS=30
HANDLE_TIMEOUT_SECONDS=300
ORPHAN_GRACE_SECONDS=900
